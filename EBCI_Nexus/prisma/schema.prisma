// Force Schema Update v2
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Phase 1: Authentication & Role-Based Access
model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  role      String   @default("employee")
  name      String?
  biometric_id     String?  @unique
  fingerprint_data String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  employee  Employee?
  reviewedLeaves LeaveRecord[]
}

model Employee {
  id             String   @id @default(cuid())
  employeeCode   String   @unique @map("employee_code")
  title          String?
  firstNameTH    String   @map("first_name_th")
  lastNameTH     String   @map("last_name_th")
  firstNameEN    String?  @map("first_name_en")
  lastNameEN     String?  @map("last_name_en")
  position       String
  department     String
  startDate      DateTime @map("start_date")
  employmentType String   @map("employment_type")
  status         String   @default("active")
  email          String   @unique
  phone          String?
  userId         String?  @unique @map("user_id")
  user           User?    @relation(fields: [userId], references: [id])
  applicantId    String?   @unique @map("applicant_id")
  applicant      Applicant? @relation(fields: [applicantId], references: [id])
  attendanceLogs AttendanceLog[]
  leaveRecords   LeaveRecord[]
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@map("employees")
}

model JobApplication {
  id               Int      @id @default(autoincrement())
  fullname_th      String?
  position_applied String?
  salary_expected  String?
  phone            String?
  email            String?
  photo_file       String?
  resume_file      String?
  created_at       DateTime @default(now())
  @@map("job_applications")
}

model Applicant {
  id              String   @id @default(cuid())
  positionApplied String   @map("position_applied")
  expectedSalary  Decimal? @map("expected_salary")
  startDate       DateTime? @map("start_date")
  employmentStatus String? @map("employment_status")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  nickname        String?  @map("nickname")
  dateOfBirth     DateTime @map("date_of_birth")
  age             Int
  gender          String?
  nationality     String?
  religion        String?
  race            String?
  phone           String
  email           String   @unique
  address         String   @map("current_address")
  residenceType   String?  @map("residence_type")
  livingDuration  Int?     @map("living_duration")
  maritalStatus   String?  @map("marital_status")
  militaryStatus  String?  @map("military_status")
  childrenCount   Int      @default(0) @map("children_count")
  skills          String?  @map("skills_json")
  documents       String?  @map("documents_json")
  photoPath       String?  @map("photo_path")
  resumePath      String?  @map("resume_path")
  status          String   @default("pending")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  educations      ApplicantEducation[]
  experiences     ApplicantExperience[]
  employee        Employee?
  @@map("applicants")
}

model ApplicantEducation {
  id            String    @id @default(cuid())
  applicantId   String    @map("applicant_id")
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  level         String
  institution   String
  major         String?
  graduatedYear Int?      @map("graduated_year")
  gpa           Decimal?
  @@index([applicantId])
  @@map("applicant_educations")
}

model ApplicantExperience {
  id            String    @id @default(cuid())
  applicantId   String    @map("applicant_id")
  applicant     Applicant @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  company       String
  position      String
  salary        Decimal?
  startDate     DateTime? @map("start_date")
  endDate       DateTime? @map("end_date")
  reasonForLeaving String? @map("reason_for_leaving")
  @@index([applicantId])
  @@map("applicant_experiences")
}

model Announcement {
  id             String   @id @default(cuid())
  headline       String
  content        String
  imagePath      String?  @map("image_path")
  priority       String   @default("internal")
  publishStatus  String   @default("draft")
  publishDate    DateTime @default(now()) @map("publish_date")
  emailSent      Boolean  @default(false) @map("email_sent")
  emailSentAt    DateTime? @map("email_sent_at")
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  @@map("announcements")
}

model AttendanceLog {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date        DateTime
  clockIn     DateTime? @map("clock_in")
  clockOut    DateTime? @map("clock_out")
  status      String    @default("present")
  location    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  @@map("attendance_logs")
  @@unique([employeeId, date])
}

model LeaveRecord {
  id          String    @id @default(cuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   String    @map("leave_type")
  startDate   DateTime  @map("start_date")
  endDate     DateTime  @map("end_date")
  reason      String?
  status      String    @default("pending")
  approvedBy  String?   @map("approved_by")
  approver    User?     @relation(fields: [approvedBy], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  @@map("leave_records")
}